    "atur-sandi": "node --disable-warning=ExperimentalWarning scripts/atur-sandi.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fastify/cookie": "11.1.3",
