    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@googleapis/drive": "26.0.2",
    "@googleapis/sheets": "18.1.1",
    "docx": "9.6.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.6",
    "google-auth-library": "11.3.1",
