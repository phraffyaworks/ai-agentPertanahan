# Salin file ini menjadi .env lalu isi nilainya. Jangan pernah mengunggah .env ke GitHub.

# Token dari @BotFather (Langkah 1 di docs/PANDUAN.md)
TELEGRAM_BOT_TOKEN=
# ID akun Telegram yang boleh memakai bot; pisahkan dengan koma bila lebih dari satu.
# Cara mengetahuinya: jalankan bot, lalu kirim /id ke bot.
TELEGRAM_ALLOWED_USER_IDS=

# Akses Google lewat Apps Script (Langkah 2, docs/APPS-SCRIPT.md)
APPS_SCRIPT_URL=
# Dibuat dan dipasangkan otomatis oleh: npm run setup
APPS_SCRIPT_SECRET=

# Alternatif lama lewat Google Cloud Client ID; hanya dipakai bila APPS_SCRIPT_URL kosong.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Dari Claude Console (Langkah 3)
ANTHROPIC_API_KEY=

# Opsional. Bawaan: folder "Otomasi" dan spreadsheet "Database Raffy" milik Anda.
# DRIVE_FOLDER_INDUK_ID=1oZlzZd7kGSbr556ido6B6pJ_1eiVScZd
# SPREADSHEET_ID=16oEsge3_1bmdrMf_j_5KDDYL2_DilODbuLaILg0bYJs
# SHEET_MASTER=Master Data
# Model dan tingkat berpikir (low, medium, high, xhigh, max). Bawaan: claude-sonnet-5-5, medium.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=medium
